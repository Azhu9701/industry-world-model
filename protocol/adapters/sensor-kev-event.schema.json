{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiman.world/industry-world-model/protocol/v0.3/adapters/sensor-kev-event.schema.json",
  "title": "AIMAN Sensor + Kev Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "pack",
    "observed_at",
    "contributor",
    "idempotency_key",
    "sensor",
    "kev"
  ],
  "properties": {
    "envelope_version": {"const": "0.1.0"},
    "pack": {"const": "robotics"},
    "observed_at": {"type": "string", "format": "date-time"},
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["human", "agent", "organization"]},
        "display_name": {"type": ["string", "null"]}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 1},
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_status", "title", "event_date", "event_key", "event_class", "history_link", "facts", "sources", "related_entities", "significance"],
      "properties": {
        "verification_status": {"type": "string", "enum": ["verified", "insufficient_evidence"]},
        "title": {"type": "string", "minLength": 4, "maxLength": 180},
        "event_date": {"type": "string", "format": "date"},
        "event_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
        "event_class": {"type": "string", "enum": ["new_event", "follow_up", "enrichment"]},
        "history_link": {"type": "string", "enum": ["linked", "independent"]},
        "predecessor_event_id": {"type": ["integer", "null"], "minimum": 1},
        "relation": {"type": ["string", "null"]},
        "history_reason": {"type": ["string", "null"]},
        "facts": {
          "type": "array", "minItems": 2, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim", "source_urls"],
            "properties": {
              "claim": {"type": "string", "minLength": 4, "maxLength": 800},
              "source_urls": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://"}}
            }
          }
        },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "title", "source_type"],
            "properties": {
              "url": {"type": "string", "pattern": "^https?://"},
              "title": {"type": "string", "minLength": 1, "maxLength": 300},
              "source_type": {"type": "string", "enum": ["official", "government", "paper", "wire", "industry_media", "other"]},
              "publisher": {"type": ["string", "null"]},
              "published_at": {"type": ["string", "null"]}
            }
          }
        },
        "caveats": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 600}},
        "related_entities": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "significance": {"type": "string", "minLength": 20, "maxLength": 1600}
      }
    },
    "kev": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "contract_version", "decision_packet"],
      "properties": {
        "model": {"const": "aiman-kev-v0.2c"},
        "contract_version": {"const": "0.2"},
        "contract_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "model_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "decision_packet": {
          "type": "object", "additionalProperties": true,
          "required": ["content_type", "is_event", "event_type", "timeline_worthy", "commercialization_stage", "source_quality", "needs_second_source"],
          "properties": {
            "content_type": {"type": "string", "enum": ["event", "roundup", "company_digest", "product_profile", "editorial", "archive"]},
            "is_event": {"type": "boolean"},
            "event_type": {"type": "string", "enum": ["technology", "product", "case", "market", "funding", "policy", "other"]},
            "timeline_worthy": {"type": "boolean"},
            "commercialization_stage": {"type": "string", "enum": ["research_demo", "launch", "mass_production", "deployment", "not_applicable"]},
            "source_quality": {"type": "string", "minLength": 1},
            "needs_second_source": {"type": "boolean"}
          }
        }
      }
    }
  }
}
