{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiman.world/industry-world-model/protocol/v0.3/entity.schema.json",
  "title": "Industry World Model Entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entity_type",
    "entity_key",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^entity:[A-Za-z0-9._:-]+$"
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "entity_key": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "attributes": {
      "type": "object"
    }
  }
}
