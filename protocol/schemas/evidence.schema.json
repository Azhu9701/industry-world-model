{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiman.world/industry-world-model/protocol/v0.3/evidence.schema.json",
  "title": "Industry World Model Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target",
    "source",
    "captured_at",
    "stance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evidence:[A-Za-z0-9._:-]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "claim",
            "relation",
            "event"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "source_type"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": "string",
          "enum": [
            "first_party",
            "government",
            "regulator",
            "academic",
            "repository",
            "media",
            "database",
            "other"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "excerpt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "stance": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "context"
      ]
    }
  }
}
