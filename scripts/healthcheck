#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
if [ -f "$ROOT/.env" ]; then
    set -a
    . "$ROOT/.env"
    set +a
fi

curl --noproxy '*' -fsS "http://127.0.0.1:${API_PORT:-8080}/health" >/dev/null
curl --noproxy '*' -fsS "http://127.0.0.1:${AGENT_PORT:-8090}/health" >/dev/null
curl --noproxy '*' -fsS "http://127.0.0.1:${WEB_PORT:-3000}" >/dev/null
echo "healthcheck passed: web, api, agent"
