{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2024"],
    "skipLibCheck": true,
    "target": "ES2024",
    "paths": { "~/*": ["./src/*"] },
    "noEmit": true
  }
}
